@startuml 03-diagrama-de-casos-de-uso
title Diagrama de Casos de Uso - Automação de Vendas WhatsApp + PIX + Uber Flash

left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

' ---------- Atores humanos ----------
actor "Cliente" as Cliente
actor "Lojista\n(Administrador)" as Lojista
actor "Operador" as Operador

' ---------- Atores de sistema ----------
actor "WhatsApp API\n(Meta)" as WhatsApp <<sistema externo>>
actor "Gateway PIX" as Gateway <<sistema externo>>
actor "Uber Direct API" as Uber <<sistema externo>>
actor "Agendador\n(Scheduler)" as Agendador <<sistema interno>>

rectangle "Sistema de Vendas via WhatsApp" {

  package "Atendimento, Catálogo e Cotação" {
    usecase "UC-01\nIniciar atendimento" as UC01
    usecase "UC-02\nConsultar catálogo" as UC02
    usecase "UC-03\nMontar carrinho" as UC03
    usecase "UC-04\nInformar e confirmar\nendereço de entrega" as UC04
    usecase "UC-05\nObter cotação de frete\ne total do pedido" as UC05
    usecase "UC-06\nRenovar cotação expirada" as UC06
    usecase "UC-07\nSolicitar atendente humano" as UC07
    usecase "Reservar estoque" as UCRes
    usecase "Validar endereço\n(geocodificação)" as UCGeo

    UC01 -[hidden]down-> UC02
    UC02 -[hidden]down-> UC03
    UC03 -[hidden]down-> UC04
    UC04 -[hidden]down-> UC05
    UC05 -[hidden]down-> UC06
    UC06 -[hidden]down-> UC07
  }

  package "Pagamento PIX" {
    usecase "UC-08\nPagar via PIX" as UC08
    usecase "UC-09\nProcessar confirmação\nde pagamento (Webhook)" as UC09
    usecase "UC-10\nTratar pagamento atrasado\nou frete acima da tolerância" as UC10
    usecase "UC-11\nEscolher pagar diferença\nou receber estorno" as UC11
    usecase "UC-12\nEstornar pagamento" as UC12
    usecase "UC-13\nConciliar pagamentos\ncom o gateway" as UC13
    usecase "UC-14\nExpirar pedido e PIX" as UC14
    usecase "Validar valor, txid\ne idempotência" as UCVal

    UC08 -[hidden]down-> UC09
    UC09 -[hidden]down-> UC10
    UC10 -[hidden]down-> UC11
    UC11 -[hidden]down-> UC12
    UC12 -[hidden]down-> UC13
    UC13 -[hidden]down-> UC14
  }

  package "Entrega Uber Flash" {
    usecase "UC-15\nSolicitar entrega\nautomaticamente" as UC15
    usecase "UC-16\nRetentar busca de entregador" as UC16
    usecase "UC-17\nProcessar status da corrida\n(Webhook Uber)" as UC17
    usecase "UC-18\nTratar falha na entrega" as UC18
    usecase "UC-19\nCancelar pedido ou entrega" as UC19
    usecase "Reconferir estoque\ne valor do frete" as UCReconf

    UC15 -[hidden]down-> UC16
    UC16 -[hidden]down-> UC17
    UC17 -[hidden]down-> UC18
    UC18 -[hidden]down-> UC19
  }

  package "Notificações e Pós-venda" {
    usecase "UC-20\nReceber PIN e link\nde rastreamento" as UC20
    usecase "UC-21\nReceber notificações\nde status" as UC21
    usecase "UC-22\nConsultar status do pedido" as UC22
    usecase "UC-23\nConcluir pedido e\nenviar pesquisa" as UC23
    usecase "UC-24\nAbrir ocorrência pós-entrega" as UC24

    UC20 -[hidden]down-> UC21
    UC21 -[hidden]down-> UC22
    UC22 -[hidden]down-> UC23
    UC23 -[hidden]down-> UC24
  }

  package "Painel Administrativo" {
    usecase "UC-25\nAutenticar no painel" as UC25
    usecase "UC-26\nGerenciar catálogo e estoque" as UC26
    usecase "UC-27\nAcompanhar pedidos" as UC27
    usecase "UC-28\nConfigurar regras de\nfrete e pagamento" as UC28
    usecase "UC-29\nConsultar financeiro\ne conciliação" as UC29
    usecase "UC-30\nReceber alertas operacionais" as UC30
    usecase "UC-31\nAtender cliente em\ntransferência humana" as UC31

    UC25 -[hidden]down-> UC26
    UC26 -[hidden]down-> UC27
    UC27 -[hidden]down-> UC28
    UC28 -[hidden]down-> UC29
    UC29 -[hidden]down-> UC30
    UC30 -[hidden]down-> UC31
  }
}

' Layout entre pacotes
"Atendimento, Catálogo e Cotação" -[hidden]down-> "Pagamento PIX"
"Pagamento PIX" -[hidden]down-> "Notificações e Pós-venda"
"Entrega Uber Flash" -[hidden]down-> "Painel Administrativo"

' ---------- Cliente ----------
Cliente --> UC01
Cliente --> UC02
Cliente --> UC03
Cliente --> UC04
Cliente --> UC05
Cliente --> UC06
Cliente --> UC07
Cliente --> UC08
Cliente --> UC11
Cliente --> UC20
Cliente --> UC21
Cliente --> UC22
Cliente --> UC24
Cliente --> UC19

' ---------- Lojista ----------
Lojista --> UC25
Lojista --> UC26
Lojista --> UC27
Lojista --> UC28
Lojista --> UC29
Lojista --> UC30
Lojista --> UC12
Lojista --> UC19

' ---------- Operador ----------
Operador --> UC25
Operador --> UC27
Operador --> UC31

' ---------- Sistemas externos e internos ----------
WhatsApp --> UC01 : mensagens
Gateway --> UC09 : Webhook de pagamento
Uber --> UC17 : Webhook de status
UC05 --> Uber : cotação
UC08 --> Gateway : cobrança PIX
UC12 --> Gateway : devolução
UC13 --> Gateway : consulta
UC15 --> Uber : cria corrida
UC19 --> Uber : cancela corrida
Agendador --> UC14
Agendador --> UC13
Agendador --> UC16

' ---------- Include / Extend ----------
UC03 .right.> UCRes : <<include>>
UC05 .right.> UCRes : <<include>>
UC04 .right.> UCGeo : <<include>>
UC06 .up.> UC05 : <<include>>
UC09 .right.> UCVal : <<include>>
UC09 .right.> UC15 : <<include>>
UC15 .right.> UCReconf : <<include>>
UC15 .down.> UC20 : <<include>>
UC10 .up.> UC09 : <<extend>>
UC10 .down.> UC11 : <<include>>
UC11 .down.> UC12 : <<extend>>
UC16 .up.> UC15 : <<extend>>
UC18 .up.> UC17 : <<extend>>
UC18 .left.> UC12 : <<extend>>
UC14 .up.> UC06 : <<extend>>
UC23 .up.> UC17 : <<extend>>
UC21 .up.> UC17 : <<extend>>
UC07 .right.> UC31 : <<include>>

note right of UC10
  RN-08: atrasado ou frete acima
  da tolerância -> nova cotação,
  decisão do cliente, PIX
  complementar ou estorno.
end note

note bottom of UC15
  RN-04: despachar se frete atual
  menor ou igual ao cobrado,
  absorver dentro da tolerância
  ou acionar UC-10.
end note

@endl